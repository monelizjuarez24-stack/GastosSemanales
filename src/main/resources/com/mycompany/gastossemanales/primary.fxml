<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.gastossemanales.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox spacing="50.0" alignment="CENTER_LEFT">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Alimentación" prefWidth="90.0" />
                            <TextField fx:id="txtAlimentacion" prefWidth="100.0" />
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Refrigerios" prefWidth="90.0" />
                            <TextField fx:id="txtRefrigerios" prefWidth="100.0" />
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Transporte" prefWidth="90.0" />
                            <TextField fx:id="txtTransporte" prefWidth="100.0" />
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Telefonía" prefWidth="90.0" />
                            <TextField fx:id="txtTelefonia" prefWidth="100.0" />
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Otros" prefWidth="90.0" />
                            <TextField fx:id="txtOtros" prefWidth="100.0" />
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Button text="Calcular estadísticas" onAction="#calcularEstadisticas" />
                            <Button text="Limpiar" onAction="#limpiarCampos" />
                        </HBox>
                    </children>
                </VBox>
                <VBox spacing="15.0">
                    <children>
                        <Label text="Estadísticas" />
                        <Label text="Total semanal" />
                        <TextField fx:id="txtTotal" editable="false" prefWidth="120.0" />
                        <Label text="Gasto más alto" />
                        <TextField fx:id="txtGastoAlto" editable="false" prefWidth="150.0" />
                    </children>
                </VBox>
                
            </children>
        </HBox>
    </children>
</VBox>
